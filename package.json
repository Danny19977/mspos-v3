    "@ng-web-apis/geolocation": "^4.6.5",
    "apexcharts": "^5.3.6",
    "bootstrap": "^5.3.4",
    "chart.js": "^4.4.2",
    "dexie": "^4.0.11",
    "i": "^0.3.7",
    "lightgallery": "^2.7.2",
    "ng-apexcharts": "^1.11.0",
